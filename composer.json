{
    "name": "agenceweb/alma-sylius-payment-plugin",
    "type": "sylius-plugin",
    "description": "Alma payments (instalments, pay later) for Sylius 2 — fork of alma/sylius-payment-plugin 2.1.0 made compatible with Sylius 2.",
    "keywords": [
        "alma",
        "buy now pay later",
        "bnpl",
        "installments",
        "payment",
        "sylius",
        "sylius-plugin"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "sylius/sylius": "^2.0",
        "alma/alma-php-client": "2.6.1"
    },
    "replace": {
        "alma/sylius-payment-plugin": "*"
    },
    "autoload": {
        "psr-4": {
            "Alma\\SyliusPaymentPlugin\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.1-dev"
        }
    },
    "authors": [
        {
            "name": "Alma",
            "email": "contact@almapay.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/thanks": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true
        }
    }
}
